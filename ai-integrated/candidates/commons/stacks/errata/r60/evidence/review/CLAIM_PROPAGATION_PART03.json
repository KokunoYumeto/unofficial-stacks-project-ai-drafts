  "claims": [
    {
      "claim_id": "HOMOLOGY-UNDER-004",
      "kind": "graded_dual_equivalence",
      "source_label": "lemma-left-dual-graded-vector-spaces",
      "original_source_lines": [
        4063,
        4107
      ],
      "original_statement": "A left dual implies finite total dimension and nondegenerate opposite-degree pairings.",
      "proved_statement": "A graded F-vector space has a left dual if and only if its total dimension is finite; evaluation identifies W^{-n} with (V^n)^*. The displayed finite coevaluation and evaluation obey both triangles and are basis-independent.",
