      ],
      "original_statement": "Compatible split resolution stages are bounded above, or dually bounded below.",
      "proved_statement": "Stages can be chosen with P_n^r=0 for r>n, and dually I_n^r=0 for r<-n. A surjective cone resolution gives P_(n+1)=P_n direct-sum Q with differential [[dP,-v],[0,dQ]], augmentation (a,u), and an exact identity of its cone with C(q), so compatibility and surjectivity hold on chain maps without an extra disk.",
      "hypotheses": "An abelian category and a zero-containing finite-sum-closed class surjecting onto every object; the exact opposite hypotheses for the inverse system.",
      "proof": {
        "file": "PROOFS_9206_9744.md",
        "bytes": 24736,
        "sha256": "CA189E7AD075EE9775FBB6AEEF460692723F731F9B196DA2FD61BF2853A553E7",
        "sections": [
          1,
          2,
          4
        ]
      },
      "status": "proved_editorial_consequence",
      "body_replacement": false,
      "novelty": "not_claimed",
      "limits": "No functorial choice of all resolutions or general inverse-limit comparison is asserted."
    },
    {
      "claim_id": "DERIVED-UNDER-020",
      "source_lines": [
        9332,
        9442
      ],
      "original_statement": "The existence criterion assumes right exactness and preservation of all sequential colimits by F.",
      "proved_statement": "It suffices that F is additive, preserves countable coproducts, and takes bounded above acyclic complexes of P objects to acyclic complexes; both abelian categories still have exact sequential colimits. The same strict systems compute LF on the entire unbounded derived category, with comparisons proved compatible at every stage.",
      "hypotheses": "The stated P covering and finite-sum hypotheses, exact sequential colimits in A and B, and the specified additive F assumptions.",
      "proof": {
        "file": "PROOFS_9206_9744.md",
        "bytes": 24736,
        "sha256": "CA189E7AD075EE9775FBB6AEEF460692723F731F9B196DA2FD61BF2853A553E7",
        "sections": [
          1,
          2,
          3
        ]
      },
      "status": "proved_editorial_consequence",
      "body_replacement": false,
      "novelty": "not_claimed",
      "example": "For abelian groups F(M)=M[ell] with P free, LF=0 although F is not right exact.",
      "limits": "No assertion H^0 LF(M)=F(M) without right exactness, and no removal of exact sequential colimits."
    }
