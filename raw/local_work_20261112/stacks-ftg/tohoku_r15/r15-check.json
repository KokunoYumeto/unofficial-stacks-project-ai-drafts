  "deltas": {
    "decisions": [
      {
        "action": "replace",
        "decision_id": "D000927",
        "disposition": "existing_equivalent",
        "rationale": "Stacks now defines the group-valued and sheaf-valued equivariant Ext functors as the right derived functors of h_{O,G,A} and bold h_{O,G,A}, giving exactly formulas (5.6.6) and the authority-corrected (5.6.7). The global functor carries the argument X, while the sheaf-valued functor does not. No functoriality, locality, stalk, acyclicity, or spectral-sequence claim is included.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-definition-equivariant-ext",
        "supersedes": "D000606",
        "unit_id": "tohoku:definition:equivariant-ext"
      },
      {
        "action": "replace",
        "decision_id": "D000928",
        "disposition": "existing_equivalent",
        "rationale": "Stacks now proves that, for fixed A, the global and sheaf-valued equivariant Ext families are universal cohomological delta functors in B and recover the corresponding equivariant Hom functors in degree zero; identifies the global groups with Ext in Mod_G(O); proves that both families are contravariant cohomological delta functors in A for fixed B; proves the local restriction isomorphism (5.6.8) on every open U in Y; and proves the induced-slice reduction, so for a discontinuous action the local computation reduces to the finite stabilizer G_x. This is in the inherited commutative G-ringed-space setting. No stalk-to-fiber comparison, Lemma 5.6.1 acyclicity, or later spectral-sequence claim is included.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-definition-equivariant-ext;cohomology-lemma-equivariant-ext-properties;cohomology-lemma-localize-equivariant-ext;cohomology-lemma-equivariant-ext-slice",
        "supersedes": "D000626",
        "unit_id": "tohoku:property:equivariant-ext-functoriality"
      }
    ],
