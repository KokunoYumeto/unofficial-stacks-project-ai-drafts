  "deltas": {
    "active_source_issues": [],
    "decisions": [
      {
        "action": "replace",
        "decision_id": "D000994",
        "disposition": "existing_equivalent",
        "rationale": "Under exactly the source hypothesis that every object admits an injective effacement, Stacks proves that the universal nonnegative right-satellite system is exact if and only if F is half-exact and, for every P subset Q subset R, the kernel of F(Q/P) to F(R/P) is contained in the image of F(Q) to F(Q/P). It also proves that left exactness or right exactness implies these conditions. The proof propagates the criterion through successive right satellites and does not substitute enough injectives, derived functors, or an all-degree padded convention. The separately targeted proof-stage footnote is not included in this decision.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "homology-lemma-right-satellites-exactness-criterion",
        "supersedes": "D000216",
        "unit_id": "tohoku:thm:2.2.2:p2"
      },
      {
        "action": "set",
        "decision_id": "D000995",
        "disposition": "existing_equivalent",
        "rationale": "Under the proof-stage footnote's enough-injectives hypothesis, and retaining the theorem's separate half-exactness requirement on F, Stacks proves that for every P subset Q subset R the kernel of F(Q/P) to F(R/P) is contained in the image of F(Q) to F(Q/P). Thus the universal nonnegative right-satellite system is exact exactly when F is half-exact. No left/right exactness, arbitrary-F exactness, derived-functor identification, negative satellites, or all-degree assertion is substituted.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "homology-lemma-half-exact-nested-subobjects-enough-injectives",
        "supersedes": "",
        "unit_id": "tohoku:footnote:2bis"
      }
    ],
