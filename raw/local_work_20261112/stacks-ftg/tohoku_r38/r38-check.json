    "decisions": [
      {
        "action": "replace",
        "decision_id": "D000992",
        "disposition": "existing_equivalent",
        "rationale": "Stacks now proves the first assertion of Tohoku Theorem 2.2.2 under the same hypotheses. If every object of the abelian source category has an injective effacement, every covariant additive functor to an abelian category admits a universal graded connecting functor of step +1 in all nonnegative degrees with degree-zero functor F, and every positive component is effaceable. The construction forms the first satellite as the cokernel of F(E_A) to F(Q_A), proves independence of the chosen lifts, functoriality, boundary naturality, the complex identities, universality, and effaceability, and then iterates it. No exactness of the satellite system, exactness criterion, negative or left satellites, contravariant version, or derived-functor identification is asserted.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "homology-lemma-first-right-satellite-injective-effacements;homology-lemma-right-satellites-injective-effacements",
        "supersedes": "D000215",
        "unit_id": "tohoku:thm:2.2.2:p1"
