  "planned_decisions": [
    {
      "decision_id": "D001032",
      "unit_id": "tohoku:theorem:3.9.1",
      "action": "replace",
      "disposition": "existing_equivalent",
      "stacks_labels": "cohomology-lemma-covering-acyclicity-local-killing",
      "rationale": "Stacks now proves the covering-family local-killing theorem under the corrected cross-cover trace axiom: for any two assigned coverings R and R' of A and any member B of R, the trace of R' on B is assigned to B. The finite-closed and paracompact locally-finite-closed Leray--Cartan spectral sequences supply the required edge sequence; the two inductions give vanishing through degree n-1 and the exact degree-n local-killing criterion. Source defect D1012-R001 is preserved diplomatically and corrected by TOH-P179-COR-002 and TOH-SRC-P179-009.",
      "review_state": "integrated_source_stacks_and_independent_review",
      "supersedes": "D000446"
    },
    {
      "decision_id": "D001033",
      "unit_id": "tohoku:corollary:3.9.1:1",
      "action": "replace",
      "disposition": "existing_equivalent",
      "stacks_labels": "cohomology-lemma-covering-acyclicity-conditions",
      "rationale": "Stacks now proves that derived-cohomology vanishing through degree n is equivalent to coverwise Cech vanishing A(n) together with finite common-intersection local killing B(n), using the repaired local-killing theorem and the closed-cover spectral sequence. No official tag is claimed.",
      "review_state": "integrated_source_stacks_and_independent_review",
      "supersedes": "D000378"
    },
    {
      "decision_id": "D001034",
      "unit_id": "tohoku:corollary:3.9.1:2",
      "action": "replace",
      "disposition": "existing_equivalent",
      "stacks_labels": "cohomology-lemma-special-coverings-compute-acyclicity",
      "rationale": "Stacks now proves the cofinal special-cover criterion: if every open covering is refined by a finite common intersection of assigned coverings, local killing makes every B(m) automatic, so derived vanishing through degree n is equivalent to assigned-cover cohomology vanishing through degree n. No official tag is claimed.",
      "review_state": "integrated_source_stacks_and_independent_review",
      "supersedes": "D000379"
    },
    {
      "decision_id": "D001035",
      "unit_id": "tohoku:corollary:3.9.1:3",
      "action": "replace",
      "disposition": "existing_equivalent",
      "stacks_labels": "cohomology-lemma-bounded-nerve-special-coverings-acyclic",
      "rationale": "Stacks now proves the bounded-nerve upgrade: alternating normalization kills assigned-cover cohomology above the uniform nerve dimension, while the special-cover criterion supplies all lower degrees, hence all positive-degree derived cohomology vanishes. No official tag is claimed.",
      "review_state": "integrated_source_stacks_and_independent_review",
      "supersedes": "D000380"
    },
    {
      "decision_id": "D001036",
      "unit_id": "tohoku:section:3.9",
      "action": "replace",
      "disposition": "existing_equivalent",
      "stacks_labels": "cohomology-section-covering-acyclicity-criteria",
      "rationale": "The new Stacks section on acyclicity criteria by coverings collects the open, finite-closed, and paracompact locally-finite-closed Leray--Cartan spectral sequence together with the repaired local-killing theorem and its three corollaries. Proposition 3.9.2, its application, and the nonabelian remark remain separately tracked subordinate units. No official tag is claimed.",
      "review_state": "integrated_source_stacks_and_independent_review",
      "supersedes": "D000329"
    }
  ],
  "planned_issue": {
    "issue_id": "I000031",
    "unit_id": "tohoku:setup:acyclicity-cover-families",
    "status": "resolved",
    "kind": "source_internal_quantifier_omission",
    "claim": "The printed p. 179 setup quantifies only the trace of a covering on one of its own members, but the p. 180 induction traces each different covering R^i onto a member B of R^1. The cross-cover trace closure required by the induction is therefore omitted.",
