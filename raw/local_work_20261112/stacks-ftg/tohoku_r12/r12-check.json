    "decisions": [
      {
        "action": "replace",
        "decision_id": "D000922",
        "disposition": "existing_equivalent",
        "rationale": "Stacks now defines the source's local and global groups of G-O-homomorphisms on every G-stable open U and proves that they are the G-fixed sections of the equivariant internal Hom sheaf, giving formula (5.6.1) on X. This is the commutative-ringed-space form native to Stacks; the quotient Hom sheaf on X/G and the later derived Ext, localization, acyclicity, and spectral-sequence claims are not included.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-lemma-equivariant-internal-hom",
        "supersedes": "D000608",
        "unit_id": "tohoku:definition:equivariant-o-homomorphisms"
      },
      {
        "action": "replace",
        "decision_id": "D000923",
        "disposition": "existing_equivalent",
        "rationale": "Stacks now states the conjugation action on internal Hom explicitly as (g phi)(a) = g phi(g^{-1}a), exactly matching the source. Only this action formula is covered; the coinduced-module construction and acyclicity argument surrounding it on p. 216 are not included.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-lemma-equivariant-internal-hom",
        "supersedes": "D000604",
        "unit_id": "tohoku:definition:conjugation-action-on-hom"
