    "source_issues": [
      {
        "claim": "The active local correction TOH-SRC-P217-001 changes the printed Y in spectral sequence I of (5.6.11) to X, but bold Ext_{O,G}^q(A,B) is a sheaf on Y=X/G; therefore H^p(Y,-) is type-correct, whereas H^p(X,-) is undefined without an additional pullback.",
        "control": "Preserve Y diplomatically. In the next authorized no-overwrite source and semantic successor, reverse TOH-SRC-P217-001 by restoring Y in corrected French, English, and tohoku:equation:5.6.11. Keep D000655 open while its structural child carries X; after the correction is admitted, append a resolving mapping successor to D000655.",
        "evidence": "Official Part II SHA-256 8D632A04EE0FA987B40B721BEE6E64BB3E641D6A1CE02335556213F1564C9A53, printed pp. 214 and 217: (5.6.2) defines the equivariant Hom sheaf on Y=X/G, the discussion following (5.6.7) says the corresponding bold Ext objects are sheaves on Y, and (5.6.11) prints H^p(Y,bold Ext). TOH-SRC-P217-001 and the corrected French, English, and sem/r10 equation row instead carry X.",
        "evidence_labels": "cohomology-definition-equivariant-ext;cohomology-lemma-equivariant-ext-spectral-sequences",
        "issue_id": "I000022",
        "kind": "source_correction_wrong_base_space",
        "resolution_decision": "",
        "status": "confirmed",
        "unit_id": "tohoku:equation:5.6.11"
      }
    ],
