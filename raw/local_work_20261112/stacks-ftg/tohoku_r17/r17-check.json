  "deltas": {
    "decisions": [
      {
        "action": "replace",
        "decision_id": "D000934",
        "disposition": "existing_equivalent",
        "rationale": "Stacks now constructs from the three factorizations (5.6.5) the additive first-quadrant spectral sequences I--III, functorial in B from E_2 onward, identifies their nonequivariant inner derived functors with global Ext and sheaf Ext carrying their induced G-actions, and proves that all three converge to Ext_{O,G}^{p+q}(X;A,B). This exactly covers the p. 216 unit; spectral sequence I uses the authority-correct quotient space Y.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-lemma-equivariant-underlying-ext;cohomology-lemma-equivariant-ext-spectral-sequences",
        "supersedes": "D000650",
        "unit_id": "tohoku:spectral-sequence:three-equivariant-ext-sequences"
      },
      {
        "action": "replace",
        "decision_id": "D000935",
        "disposition": "existing_equivalent",
        "rationale": "Stacks now proves the equivariant continuation explicitly: an injective resolution in Mod_G(O) is underlying-injective, so deriving ordinary global Hom and internal Hom on the equivariant category computes ordinary global Ext and sheaf Ext, with their canonical induced G-actions.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-lemma-equivariant-underlying-ext",
        "supersedes": "D000631",
        "unit_id": "tohoku:relation:derived-hom-functors"
      },
      {
        "action": "replace",
        "decision_id": "D000936",
        "disposition": "existing_equivalent",
        "rationale": "Stacks now constructs the same three functorial first-quadrant equivariant Ext spectral sequences and explicitly records their canonical edge homomorphisms and associated five-term exact sequences, exactly the source consequence.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-lemma-equivariant-ext-spectral-sequences",
        "supersedes": "D000577",
        "unit_id": "tohoku:consequence:edge-homomorphisms-five-term"
      },
      {
        "action": "replace",
        "decision_id": "D000937",
        "disposition": "existing_equivalent",
        "rationale": "For an underlying O-module A locally isomorphic to finite free O^r, SheafHom_O(A,-) is exact, so ordinary SheafExt_O^q(A,B)=0 for q>0. The third equivariant Ext spectral sequence therefore degenerates at E_2, and its bottom edge gives the canonical isomorphisms H^n(X;G,SheafHom_O(A,B))->Ext^n_{O,G}(X;A,B), functorial in B, exactly as in the source corollary.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-lemma-equivariant-ext-locally-free",
        "supersedes": "D000601",
        "unit_id": "tohoku:corollary:theorem-5.6.3-locally-free"
      },
      {
        "action": "replace",
        "decision_id": "D000938",
        "disposition": "existing_equivalent",
        "rationale": "For A=O, evaluation at 1 is a canonical G-equivariant O-linear isomorphism SheafHom_O(O,B)=B. Under this identification the bottom-edge isomorphism of the preceding degeneration is H^n(X;G,B)->Ext^n_{O,G}(X;O,B), functorial in B, exactly the source formula.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-lemma-equivariant-ext-locally-free",
        "supersedes": "D000602",
        "unit_id": "tohoku:corollary:theorem-5.6.3-structure-sheaf"
      }
    ],
