  "deltas": {
    "decisions": [
      {
        "action": "replace",
        "decision_id": "D000940",
        "disposition": "existing_equivalent",
        "rationale": "In the standard commutative Stacks ringed-space convention, Stacks now defines the skew group ring U generated by R and G, identifies compatible semilinear R-modules with left U-modules, constructs the associated constant equivariant sheaf, and proves the functorial identity Hom_{R,G}(M,B)=Hom_U(M,Gamma(X,B)). The exact constant-sheaf adjunction also proves that equivariant global sections preserve injective U-modules.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-lemma-equivariant-ext-crossed-product-spectral-sequence",
        "supersedes": "D000581",
        "unit_id": "tohoku:construction:constant-equivariant-crossed-product"
      },
      {
        "action": "replace",
        "decision_id": "D000941",
        "disposition": "existing_equivalent",
        "rationale": "Stacks now applies the Grothendieck spectral sequence to equivariant global sections followed by Hom_U(M,-), proves the injective-acyclicity hypothesis, identifies the inner derived functors with H^q(X,B) carrying its U-action, and obtains the functorial first-quadrant sequence IV with E_2^{p,q}=Ext_U^p(M,H^q(X,B)) converging with finite filtrations to Ext_{R,G}^{p+q}(X;M,B). The separately stated sequence V is not included.",
        "review_state": "integrated_source_stacks_and_independent_review",
        "stacks_labels": "cohomology-lemma-equivariant-ext-crossed-product-spectral-sequence",
        "supersedes": "D000649",
        "unit_id": "tohoku:spectral-sequence:iv"
      }
    ],
